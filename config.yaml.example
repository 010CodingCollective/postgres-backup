# PostgreSQL Backup Configuration
# Copy this file to config.yaml and adjust the values as needed

# Backup schedule in cron format
# Examples:
#   @daily - Run once a day at midnight
#   @hourly - Run once an hour
#   0 2 * * * - Run at 2:00 AM every day
schedule: '@daily'

# Run a backup immediately when the application starts (in addition to the schedule)
# Set to true to trigger an immediate backup run on startup
run_at_startup: false

# PostgreSQL database name
postgres_database: dbname

# PostgreSQL host and port
postgres_host: localhost
postgres_port: "5432"

# PostgreSQL username
postgres_user: user

# PostgreSQL password
postgres_password: password

# Additional options for pg_dump
# Common options:
#   --schema=public --blobs - Backup only the public schema with binary data
#   --clean --if-exists - Add DROP commands before CREATE
#   --no-owner --no-acl - Exclude owner and ACL information
postgres_extra_opts: '--schema=public -b'

# S3 Storage Configuration
# Supports AWS S3 and S3-compatible services (MinIO, DigitalOcean Spaces, Cloudflare R2, etc.)
s3:
  # Custom endpoint for S3-compatible services
  # Leave empty for AWS S3
  # Examples:
  #   MinIO: https://minio.example.com
  #   DigitalOcean Spaces: https://nyc3.digitaloceanspaces.com
  #   Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
  endpoint: ''

  # AWS region (required for AWS S3, can be any string for S3-compatible services)
  region: 'us-east-1'

  # S3 bucket name
  bucket: 'pg-backups'

  # Access credentials
  # It's recommended to use environment variables for sensitive data:
  #   S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY
  access_key_id: ''
  secret_access_key: ''

  # Use path-style addressing instead of virtual-hosted style
  # Set to true for most S3-compatible services (MinIO, Cloudflare R2, Backblaze B2, Wasabi)
  # Set to false for AWS S3 and DigitalOcean Spaces
  use_path_style: false

  # Storage class applied to uploaded backups
  # Leave empty to let the provider choose its default (STANDARD on most services)
  # Examples:
  #   AWS S3:   STANDARD, STANDARD_IA, GLACIER, GLACIER_IR, DEEP_ARCHIVE
  #   Scaleway: STANDARD, ONEZONE_IA, GLACIER
  #
  # WARNING: objects written directly to GLACIER cannot be downloaded until they
  # have been restored, which on Scaleway can take up to 24 hours to even begin.
  # Prefer leaving this empty and configuring a bucket lifecycle rule that
  # transitions older backups to GLACIER, so the most recent backup stays
  # immediately restorable. See the Scaleway section of README.md.
  storage_class: ''
